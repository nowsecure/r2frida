NAME=one-byte executable memory write
FILE=frida://0
TIMEOUT=30
CMDS=<<EOF
s `:dma 65536`
:dmp $$ 65536 r-x
wx a5
p8 1
:dmp $$ 65536 rw-
:dma- $$
EOF
EXPECT=<<EOF
a5
EOF
RUN

NAME=redirected writes preserve data and 64-bit offsets
FILE=frida://0
TIMEOUT=30
CMDS=<<EOF
e io.cache=false
!rm -f /tmp/r2frida-ts01.bin
!touch /tmp/r2frida-ts01.bin
:o /tmp/r2frida-ts01.bin~!IO
s 0
wx 10203040
s 0x100000000
wx a1b2c3d4
:o-~!IO
:m /tmp/r2frida-ts01.bin
:o /tmp/r2frida-ts01.bin~!IO
p8 4 @ 0
p8 4 @ 0x100000000
:o-~!IO
!rm -f /tmp/r2frida-ts01.bin
EOF
EXPECT=<<EOF
4294967300
10203040
a1b2c3d4
EOF
RUN

NAME=reads clamp at memory mapping boundaries
FILE=frida://0
TIMEOUT=30
CMDS=<<EOF
:e io.volatile=false
s `:dma 32768`
wx 000102030405060708090a0b0c0d0e0f @ $$+16368
:dmp `?v $$+16384` 16384 ---
p8 8 @ $$+16368
p8 16 @ $$+16368
p8 32 @ $$+16368
:dmp `?v $$+16384` 16384 rw-
:dma- $$
EOF
EXPECT=<<EOF
0001020304050607
000102030405060708090a0b0c0d0e0f
000102030405060708090a0b0c0d0e0fffffffffffffffffffffffffffffffff
EOF
RUN

